Options -Indexes
DirectoryIndex index.php

<IfModule mod_authz_core.c>
    <FilesMatch "\.(?:csv|sql|xlsx|xls|env|log|md)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^(?:config\.local\.php|config\.example\.php|app\.php|bootstrap\.php|conexion\.php)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^_IMPORTACION_PRIVADA(?:/|$) - [F,L,NC]
</IfModule>
